# Optional local Streamlit overrides (keep config.toml)
.streamlit/secrets.toml

# IDE / editor noise (keep project rules)
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Local URL shortcuts / machine-specific launchers (optional to keep scripts)
*.url

# AFIP job queue (JSON runtime + plantillas subidas; keep folder structure)
jobs/pending/*
!jobs/pending/.gitkeep
jobs/running/*
!jobs/running/.gitkeep
jobs/done/*
!jobs/done/.gitkeep
jobs/error/*
!jobs/error/.gitkeep
jobs/needs_auth/*
!jobs/needs_auth/.gitkeep
jobs/.login_lock
jobs/.worker_token
jobs/cloud_bridge.txt
jobs/worker.log
jobs/worker.log.err
jobs/chrome_afip/
uploads/afip/*
!uploads/afip/.gitkeep
