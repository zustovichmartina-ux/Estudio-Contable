# Contraseña para entrar a la app (recomendado en Vercel). Usuario: el que quieras.
APP_USER=fiordo
APP_PASSWORD=

# Base de datos compartida entre celular y compu (Upstash Redis desde el Marketplace de Vercel).
# Vercel las completa solas al conectar la integración. Sin estas variables, los datos quedan
# guardados solo en el navegador de cada dispositivo.
KV_REST_API_URL=
KV_REST_API_TOKEN=
