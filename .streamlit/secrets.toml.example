# Copiar a .streamlit/secrets.toml (local, gitignored)
# o pegar en Streamlit Cloud → Manage app → Settings → Secrets
#
# DATA_ENCRYPTION_KEY tiene que ser una clave Fernet real (44 caracteres, termina en =).
# Si dejás el placeholder, Streamlit Cloud no puede guardar el plan de cuentas.
# Generar:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY = "PEGAR_CLAVE_FERNET_AQUI"

[oficina_usuarios.admin]
nombre = "Administrador"
pin = "CAMBIAR_PIN_ADMIN"
es_admin = true

[oficina_usuarios.recepcion]
nombre = "Recepción"
pin = "CAMBIAR_PIN_RECEPCION"
es_admin = false

# Agregá más compañeros así:
# [oficina_usuarios.juan]
# nombre = "Juan Pérez"
# pin = "su_pin"
# es_admin = false

# Puente ARCA (Streamlit Cloud → PC RECEPCION).
# 1) En RECEPCION: iniciar_afip_worker.bat (deja el túnel abierto).
# 2) Copiá URL + token de jobs/cloud_bridge.txt acá (Cloud → Settings → Secrets).
# 3) Si reiniciás el túnel rápido, la URL cambia: actualizá AFIP_WORKER_URL.
# AFIP_WORKER_URL = "https://xxxx.trycloudflare.com"
# AFIP_WORKER_TOKEN = "pegar_token"

# Grok: estas dos líneas van ARRIBA, antes de cualquier [tabla].
# La clave real se crea en https://console.x.ai → API keys (no dejes xai-...).
# XAI_API_KEY = "xai-..."
# XAI_MODEL = "grok-4.6"
