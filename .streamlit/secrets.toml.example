# Copiar a .streamlit/secrets.toml (local, gitignored)
# o pegar en Streamlit Cloud → Manage app → Settings → Secrets

# Generar clave:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY = "PEGAR_CLAVE_FERNET_AQUI"

[oficina_usuarios.admin]
nombre = "Administrador"
pin = "CAMBIAR_PIN_ADMIN"
es_admin = true

[oficina_usuarios.recepcion]
nombre = "Recepción"
pin = "CAMBIAR_PIN_RECEPCION"
es_admin = false

