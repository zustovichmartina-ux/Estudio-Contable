# Puente ARCA (Streamlit Cloud → PC RECEPCION).
# 1) En RECEPCION: iniciar_afip_worker.bat (deja el túnel abierto).
# 2) Copiá URL + token de jobs/cloud_bridge.txt acá (Cloud → Settings → Secrets).
# 3) Si reiniciás el túnel rápido, la URL cambia: actualizá AFIP_WORKER_URL.
# AFIP_WORKER_URL = "https://xxxx.trycloudflare.com"
# AFIP_WORKER_TOKEN = "pegar_token"

# Grok (xAI) o Claude. Estas líneas van ARRIBA, antes de cualquier [tabla].
# Grok: https://console.x.ai → API keys
# XAI_API_KEY = "xai-..."
# XAI_MODEL = "grok-4.6"
#
# Claude: https://console.anthropic.com → API keys
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-sonnet-5"
